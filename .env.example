# 系统配置。复制为 .env；不要提交实际密码或 OAuth Secret。
# 必填；推荐 openssl rand -hex 32，十六进制可直接放入 DATABASE_URL。
POSTGRES_PASSWORD=
POSTGRES_USER=river
POSTGRES_DB=river
POSTGRES_PORT=5432

# 本机体验默认地址；正式部署改成 https://你的域名。
BASE_URL=http://localhost:8080
DOMAIN=
APP_BIND=127.0.0.1
APP_PORT=8080
# 仅在后端端口不向公网开放且位于受信任反向代理后时设为 true。
TRUST_PROXY=false

# 全站统一加入密码；留空表示不要求。访客身份和房间 guest 角色是两回事。
JOIN_PASSWORD=
GUEST_ENABLED=true
VOICE_ENABLED=true
DEFAULT_VOICE_MODE=free
SPECTATOR_VOICE_ENABLED=false
CHAT_ENABLED=true
REACTIONS_ENABLED=true

# GitHub OAuth App；两个字段均配置才启用。
# Callback URL: BASE_URL + /api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 浏览器可见的 WebRTC ICE 服务配置。[] 仅适合能直连的网络。
# 示例见 docs/DEPLOYMENT.md；生产跨网络语音请配置 TURN。
ICE_SERVERS_JSON='[]'

# DATABASE_URL 留空时，Compose 和 run-dev.sh 会构造数据库 URL。
# 直接运行 Go 时留空，仅使用无持久化开发模式。
# 如在 Compose 中自定义 URL，内置数据库地址为 db:5432。
# 下列 LISTEN_ADDR/STATIC_DIR 供直接运行后端时使用；Compose 使用容器内的值。
DATABASE_URL=
LISTEN_ADDR=:8080
STATIC_DIR=frontend/dist
